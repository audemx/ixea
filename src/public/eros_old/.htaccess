# 1. EVITAR QUE SE VEA EL CONTENIDO DE LAS CARPETAS
Options -Indexes

# 2. PROTEGER ARCHIVOS SENSIBLES
<FilesMatch "^(config\.php|database\.php|security\.php)$">
    Require all denied
</FilesMatch>

# 3. ACTIVAR EL MOTOR DE REESCRITURA DE URLS
RewriteEngine On

# 4. OCULTAR LA EXTENSIÓN .PHP
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# 5. FORZAR HTTPS 
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]